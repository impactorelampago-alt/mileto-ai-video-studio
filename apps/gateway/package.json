{
  "name": "mileto-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gateway de IA, autenticação e medição de consumo do Mileto AI Video",
  "main": "src/server.js",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "migrate": "node src/migrate.js",
    "seed": "node src/seed.js",
    "start": "node src/server.js",
    "setup": "npm run db:up && node src/migrate.js && node src/seed.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1"
  }
}
