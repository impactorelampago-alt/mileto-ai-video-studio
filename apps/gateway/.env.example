# ── Copie para .env e preencha ──────────────────────────────────────────────
# O .env NÃO vai para o Git (veja .gitignore). Este .env.example vai, sem segredos.

# Banco (bate com o docker-compose.yml)
DATABASE_URL=postgres://mileto:mileto_dev@localhost:5433/mileto_gateway

# Porta do gateway
PORT=4000

# Segredo para assinar os tokens de login. TROQUE por algo aleatório e longo.
# Gere um: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TOKEN_SECRET=troque-isto-por-uma-string-aleatoria-bem-longa

# Super admin criado pelo seed (você). Troque a senha.
ADMIN_EMAIL=mileto.apps@gmail.com
ADMIN_PASSWORD=troque-esta-senha

# Primeiro cliente real criado pelo seed (opcional). Deixe em branco para pular.
SEED_OWNER_EMAIL=impactorelampago@gmail.com
SEED_OWNER_PASSWORD=troque-esta-senha
SEED_OWNER_ORG=Impacto Relâmpago
SEED_OWNER_PLAN=enterprise

# ── Chaves de IA ────────────────────────────────────────────────────────────
# O jeito recomendado agora é cadastrar as chaves pela ABA "IA" do painel do
# super admin — elas ficam CRIPTOGRAFADAS no banco. Estas variáveis são só um
# fallback de boot: se a chave existir no painel, ela vence. Em branco = modo
# demo (áudio silencioso, não cobra).
FISH_AUDIO_KEY=
ELEVENLABS_KEY=
OPENAI_KEY=
GEMINI_KEY=

# Multiplicador de revenda: quanto você cobra por cima do custo do fornecedor.
# 1.5 = você cobra 50% a mais. Ajuste depois de saber o gross-up de importação
# (ver PLANO-COMERCIALIZACAO.md — pode precisar de 2x a 2.5x, não 1.5x).
RESELL_MULTIPLIER=1.5
